# Shared editor settings for source repositories.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

# Go and Makefile require tabs; Python and Kotlin use four-space indents.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

# Compose functions are PascalCase by convention; ktlint's naming rule allows it.
[*.{kt,kts}]
indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable
